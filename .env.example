# --- Database ---
# Neon/Vercel Postgres connection string. Use the pooled connection string if your
# provider offers one (Neon: the "-pooler" host).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Session auth ---
# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# bcrypt hash of your dashboard password. Generate with:
#   node -e 'console.log(require("bcryptjs").hashSync(process.argv[1], 10))' "your-password"
#
# IMPORTANT — escaping depends on where you're setting this, see SETUP.md:
#   - In THIS FILE / .env.local: escape every "$" as "\$" (Next.js's env loader
#     expands unescaped "$word" as a reference to another variable and will
#     silently truncate the hash otherwise). Add the backslashes yourself, or
#     regenerate with .replace(/\$/g, "\\$") appended to the command above.
#   - In the Vercel dashboard (or anywhere with no .env* file deployed): paste
#     the RAW, unescaped hash — there's no .env parser there to un-escape it.
ADMIN_PASSWORD_HASH=""

# --- Ingest endpoint (used by the daily agent to push email/news/portfolio digests) ---
# Any long random string. Generate with: openssl rand -hex 32
INGEST_API_KEY=""

# --- Google Calendar (OAuth) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client, type "Web application"). Add GOOGLE_REDIRECT_URI as an
# authorized redirect URI on that client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# Optional: comma-separated calendar IDs to pull events from (covers both "My
# calendars" and "Other calendars" in Google Calendar's UI — the API treats
# them the same). Defaults to just "primary" if unset. Once connected, visit
# GET /api/integrations/google/calendars while logged in to list your
# calendars with their IDs.
GOOGLE_CALENDAR_IDS=""

# --- TickTick (OAuth) ---
# Register an app at https://developer.ticktick.com/manage
# and set its redirect URI to match TICKTICK_REDIRECT_URI below.
TICKTICK_CLIENT_ID=""
TICKTICK_CLIENT_SECRET=""
TICKTICK_REDIRECT_URI="http://localhost:3000/api/integrations/ticktick/callback"
