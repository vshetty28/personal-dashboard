// Prisma schema for the personal dashboard.
// Two kinds of data live here:
// 1. OAuthCredential - tokens for live-synced sources (Google Calendar, TickTick)
// 2. Digest - content pushed once a day by the scheduled agent (email digest, tech news, portfolio snapshot)

generator client {
  // Classic generator with the default output location (node_modules/@prisma/client)
  // rather than the newer "prisma-client" ESM generator with a custom `output` path.
  // The custom-output + custom-tracing combination repeatedly failed to bundle the
  // query engine into Vercel's serverless functions even with binaryTargets and
  // outputFileTracingIncludes both set correctly (verified locally, still broken in
  // prod) — the default location is what Vercel's tracing has first-class,
  // well-tested support for.
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  GOOGLE
  TICKTICK
}

// One row per provider (single-user app, so no user relation needed).
model OAuthCredential {
  provider     Provider @id
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  updatedAt    DateTime @updatedAt
}

enum DigestType {
  EMAIL
  NEWS
  PORTFOLIO
}

// Pushed by the daily agent via POST /api/ingest. One row per (type, date) so
// re-running the ingest job for the same day upserts instead of duplicating.
model Digest {
  id        String     @id @default(cuid())
  type      DigestType
  date      DateTime   @db.Date
  payload   Json
  createdAt DateTime   @default(now())

  @@unique([type, date]) // also serves per-type-per-date lookups; no separate [type, date] index needed
  @@index([date]) // for "everything on this date" lookups, e.g. the date-picker history view
}
